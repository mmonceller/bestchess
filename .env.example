# Copy the values you need into your host's environment settings (Render: Environment tab).
# Locally, leave MONGODB_URI empty to store data in server/data/db.json.

# MongoDB Atlas connection string, e.g. mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
# Database name inside the cluster
MONGODB_DB=bestchess
# Port to listen on (Render sets this automatically)
PORT=3001
